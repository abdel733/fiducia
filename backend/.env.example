# Fiducia API and Prisma configuration.
# Local development defaults only. Replace every credential before deployment.
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Local services from the root docker-compose.yml
DATABASE_URL=postgresql://fiducia:fiducia_local@localhost:5432/fiducia?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fiducia-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Local-only authentication keys. Use independent random secrets outside development.
JWT_ACCESS_SECRET=local-only-access-secret-change-before-deployment
JWT_REFRESH_SECRET=local-only-refresh-secret-change-before-deployment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_HASH_KEY=local-only-otp-hash-key-change-before-deployment
OTP_LOGS_ENABLED=true
SMS_PROVIDER=mock

# Local-only cryptographic keys. Replace and securely back up before deployment.
DATA_ENCRYPTION_ACTIVE_KEY_VERSION=v1
DATA_ENCRYPTION_KEYS={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
IMEI_HASH_KEY=local-only-imei-hmac-key-change-before-deployment
CERTIFICATE_SIGNING_ACTIVE_KEY_ID=local-v1
CERTIFICATE_SIGNING_PRIVATE_KEYS={"local-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
CERTIFICATE_SIGNING_PUBLIC_KEYS={}
CERTIFICATE_VALIDITY_DAYS=7

# Mock payments are the safe local default. Configure shop credentials separately for KKiaPay.
PAYMENT_PROVIDER=mock
PLATFORM_COLLECTION_ENABLED=false
