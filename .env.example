# Local development only. Never reuse these values in production.
# DATABASE_URL: PostgreSQL connection URL
DATABASE_URL=postgresql://fiducia:fiducia_local@localhost:5432/fiducia?schema=public
# REDIS_URL: Redis connection URL
REDIS_URL=redis://localhost:6379
# API_PORT: integer, 1-65535
API_PORT=4000
# WEB_ORIGIN: allowed browser origin
WEB_ORIGIN=http://localhost:3000
# FIDUCIA_API_URL: server-side Next.js proxy target
FIDUCIA_API_URL=http://localhost:4000/v1
# NODE_ENV: development | test | production
NODE_ENV=development
# JWT secrets: at least 32 characters; replace before any deployment
JWT_ACCESS_SECRET=local-only-access-secret-change-before-deployment
JWT_REFRESH_SECRET=local-only-refresh-secret-change-before-deployment
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# OTP: 6 digits, 5-minute expiry, max 5 attempts; logs allowed only in development
SMS_PROVIDER=mock
OTP_LOGS_ENABLED=true
OTP_HASH_KEY=local-only-otp-hash-key-change-before-deployment
# Versioned AES-256 keys as JSON. Each base64 value must decode to 32 bytes.
DATA_ENCRYPTION_ACTIVE_KEY_VERSION=v1
DATA_ENCRYPTION_KEYS={"v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
# HMAC key used only for deterministic IMEI lookup, not encryption
IMEI_HASH_KEY=local-only-imei-hmac-key-change-before-deployment
# Development-only Ed25519 seed. Replace in production and retain old public keys during rotation.
CERTIFICATE_SIGNING_ACTIVE_KEY_ID=local-v1
CERTIFICATE_SIGNING_PRIVATE_KEYS={"local-v1":"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="}
CERTIFICATE_SIGNING_PUBLIC_KEYS={}
# CERTIFICATE_SIGNING_PUBLIC_KEYS stores retired key IDs mapped to 32-byte base64 Ed25519 public keys.
CERTIFICATE_VALIDITY_DAYS=7
# Private S3-compatible bucket. MinIO is local-only.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=fiducia-private
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin